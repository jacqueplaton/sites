# ==========================================================================
# LEAD AGENCY — variáveis de ambiente
# Copie para .env  (cp .env.example .env)  e preencha o que for usar.
# NUNCA versione o .env. Nenhuma chave daqui vai para o frontend.
# ==========================================================================

# --- Banco de dados -------------------------------------------------------
# Caminho do arquivo SQLite. Relativo à pasta lead-agency/.
LM_DB_PATH=data/leads.db
# Onde ficam os pesos do score e o catálogo de nichos.
LM_CONFIG_PATH=data/config.json

# --- Servidor -------------------------------------------------------------
LM_HOST=127.0.0.1
LM_PORT=8000
LM_LOG_LEVEL=INFO

# --- Detector de site -----------------------------------------------------
# Timeout de cada requisição HTTP, em segundos.
LM_HTTP_TIMEOUT=8
# Tentativas por URL (1 = sem retry).
LM_HTTP_RETRIES=2
# Intervalo mínimo entre requisições ao MESMO host, em segundos (rate limit).
LM_HTTP_INTERVALO_HOST=1.0
# Minutos que o resultado de uma verificação fica em cache.
LM_HTTP_CACHE_MIN=60
# User-Agent identificável (boa prática e exigência de vários ToS).
LM_USER_AGENT=LeadAgency/1.0 (+prospeccao-local; contato@exemplo.com.br)
# Permite testar domínios candidatos (empresa.com.br etc.) quando o lead
# não traz o campo website. Deixe "false" para nunca sair adivinhando.
LM_BUSCAR_DOMINIO_CANDIDATO=false

# --- Fontes de coleta (OpenStreetMap) -------------------------------------
# Espelhos alternativos da Overpass existem e têm limites diferentes; uma
# instância própria é o caminho para coleta em volume.
LM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
LM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Camada de IA (Fase 3 — opcional, ainda não utilizada) ----------------
# Sem chave, o app funciona normalmente: a análise por IA fica indisponível.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
