# Cabeçalhos para Netlify e Cloudflare Pages (outros hosts ignoram este arquivo).
# Prévia: não indexar. Remova a linha X-Robots-Tag só na versão comercial final.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e vídeo mantêm o nome quando são trocados: cache de 1 semana, não 1 ano.
/media/*
  Cache-Control: public, max-age=604800
